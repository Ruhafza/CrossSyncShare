# Firebase — used for Firestore (real-time sync) + Anonymous Auth only.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Supabase — used for Storage (files & images) only.
# Supabase Dashboard -> Project Settings -> API Keys
# Use the "anon" (legacy) or "publishable" (new, starts sb_publishable_) key —
# NOT the secret/service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
